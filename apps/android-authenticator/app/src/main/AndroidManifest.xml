<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".SiwdApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SiwdAuthenticator"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <!-- Cleartext only for loopback/LAN listed in network_security_config.xml.
             Public demo uses HTTPS (e.g. https://dashlogin.ronhelwig.com). -->

        <!-- adb: am start -n org.siwd.authenticator.testnet.debug/.DebugSelfTestActivity -->
        <activity
            android:name=".DebugSelfTestActivity"
            android:exported="true"
            android:label="SIWD Self-Test"
            android:theme="@style/Theme.SiwdAuthenticator" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SiwdAuthenticator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Capability URL handoff (HTTPS production / any host) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="*"
                    android:pathPrefix="/dash-auth/v1/r/" />
            </intent-filter>
            <!-- Explicit public testnet demo -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="dashlogin.ronhelwig.com"
                    android:pathPrefix="/dash-auth/v1/r/" />
            </intent-filter>
            <!-- Local loopback demo (dev) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="http"
                    android:host="127.0.0.1"
                    android:pathPrefix="/dash-auth/v1/r/" />
            </intent-filter>
            <!-- Optional LAN demo: paste capability URL if deep-link host differs.
                 Keep LAN host out of release defaults; use settings/paste for ad-hoc IPs. -->
        </activity>
    </application>
</manifest>
