# Copy to .env next to this file (apps/demo-web/.env). Never commit real secrets.
# The server loads .env automatically via dotenv (process env still wins if set).
# .env is gitignored.

# --- Core ---
# PORT=8792
# HOST=127.0.0.1
# SIWD_PUBLIC_ORIGIN=http://127.0.0.1:8792
# SIWD_DB_PATH=./data/demo.sqlite
# SIWD_VERIFY_MODE=hybrid
# SIWD_ENABLE_SIMULATOR=true

# Site owners (comma-separated Dash names and/or identity IDs).
# Empty = every signed-in user is an owner (local bootstrap only).
# Public testnet demo example:
# SIWD_SITE_OWNER_NAMES=ronhelwig4test

# --- Public testnet host (example: https://dashlogin.ronhelwig.com) ---
# SIWD_PUBLIC_ORIGIN=https://dashlogin.ronhelwig.com
# SIWD_VERIFY_MODE=platform
# SIWD_ENABLE_SIMULATOR=false
# SIWD_SITE_OWNER_NAMES=ronhelwig4test
# SIWD_SHARED_HOST_NOTICE=true
# One bridge (legacy):
# SIWD_PLATFORM_BRIDGE=http://127.0.0.1:19792
# Or an ordered, comma-separated failover set:
# SIWD_PLATFORM_BRIDGES=http://127.0.0.1:19792,http://127.0.0.1:19793
# Only enable when the web host can also reach DAPI directly:
# SIWD_PLATFORM_LOCAL_FALLBACK=false
# HOST=127.0.0.1
# PORT=8792
# (put TLS termination / Passenger / reverse proxy in front)

# SIWD_DONATE_URL=https://example.com/donate
# SIWD_REPO_URL=https://github.com/example/SignInWithDash
# SIWD_SHARED_HOST_NOTICE=true

# --- Contact form (signed-in users only) ---
# Recipient inbox for feedback / improvement ideas. Leave empty to disable.
# Do not put a personal production address in git; set it only in local .env / host env.
SIWD_CONTACT_TO=

# Optional From address (defaults to SIWD_SMTP_USER when set).
# SIWD_CONTACT_FROM=

# SMTP delivery. If SIWD_CONTACT_TO is set but SIWD_SMTP_HOST is empty,
# submissions are logged to the server console (useful for local demos).
# Typical cPanel: mail.yourdomain.com, port 587, SIWD_SMTP_SECURE=false
# SIWD_SMTP_HOST=
# SIWD_SMTP_PORT=587
# SIWD_SMTP_SECURE=false
# SIWD_SMTP_USER=
# SIWD_SMTP_PASS=
